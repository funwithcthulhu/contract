{
  "openapi": "3.0.3",
  "info": {
    "title": "Tiny Users API",
    "version": "0.3.0"
  },
  "paths": {
    "/users/{id}": {
      "get": {
        "summary": "Fetch a user",
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "include_deleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "email"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
